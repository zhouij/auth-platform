# Copy to .env and adjust for your deployment (docker compose picks it up
# automatically; .env is gitignored). All values below are DEVELOPMENT
# defaults — replace them before any production deployment.

# --- Shared internal secret (IAM <-> auth-server <-> gateway) ---
IAM_INTERNAL_TOKEN=dev-internal-token

# --- Database passwords (must match docker/postgres/init/01-create-databases.sql) ---
IAM_DB_PASS=iam_pass
AUTH_DB_PASS=auth_pass
RESOURCE_DB_PASS=resource_pass

# --- OAuth / OIDC ---
# Externally reachable issuer URL; downstream services validate tokens against it.
AUTH_ISSUER=http://localhost:9081
# Audience(s) written into access tokens (comma-separated).
AUTH_TOKEN_AUDIENCE=resource-server
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=12h

# --- Web client BFF ---
WEB_CLIENT_ID=web-client
WEB_CLIENT_SECRET=secret

# --- Email (leave disabled for local dev; the links are logged instead) ---
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@localhost
EMAIL_RESET_LINK_BASE=http://localhost:3000/reset-password
EMAIL_VERIFICATION_LINK_BASE=http://localhost:3000/verify-email
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Gateway hardening ---
# Denylist enforcement is ON by default in Docker; disable only for
# localhost-only dev runs of the gateway.
GATEWAY_REVOCATION_CHECK_ENABLED=true
# Comma-separated browser origins allowed to call the gateway API.
GATEWAY_CORS_ALLOWED_ORIGINS=
# HSTS only makes sense behind TLS.
GATEWAY_HSTS_ENABLED=false
AUTH_HSTS_ENABLED=false

# --- Dynamic client registration (POST /api/v1/clients) ---
# Unset = disabled. Set to a strong random value to enable.
AUTH_CLIENT_REGISTRATION_TOKEN=

# --- Signing keys ---
# Paths inside the containers; compose mounts dedicated volumes at these
# locations and the files are generated (0600) on first boot.
# AUTH_SIGNING_KEY_PATH=/secrets/auth-signing.jwk
# IAM_SIGNING_KEY_PATH=/secrets/iam-signing.key
